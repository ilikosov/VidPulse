# Server
PORT=3000

# Database (SQLite file paths — REQUIRED)
DATABASE_PATH=apps/server/src/db/dev.sqlite3
TEST_DATABASE_PATH=apps/server/src/db/dev.test.sqlite3

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
LOG_YOUTUBE_API_CALLS=false
# YOUTUBE_API_PROXY=http://proxy-host:8080
# YOUTUBE_API_PROXY_USER=username
# YOUTUBE_API_PROXY_PASS=password
# YOUTUBE_API_CONNECTIVITY_TIMEOUT=5000
# YOUTUBE_API_REQUEST_TIMEOUT=10000   # ms; abort a YouTube API request after this timeout

# Sync scheduler
SYNC_CRON_TIME=0 3 * * *

# Videos
HIDE_FLAGGED_VIDEOS=false
MAX_VIDEO_LIST_ITEMS=100

# Files (physical files on disk; linked to videos by youtube_id filename prefix)
# FILES_INPUT_DIR=/path/to/incoming   # directory scanned for new files
# FILES_OUTPUT_DIR=/path/to/library   # directory files are moved to after renaming
# FILES_FILTER=mp4,mkv,avi,mov        # comma-separated extensions to include (all files if unset)
# SHELL_COMMAND_VIDEO action — a free-form command. Uses {{video.param}} tokens and an optional
# {{each video}}…{{/each}} loop so a multi-video selection becomes one command.
# (Do not use '#' in the template — dotenv treats '#' as a comment character.)
#
# Available params: youtube_id, youtube_url, title, group_name, artist_name,
#                   song_title (songs joined by " + "), songs (array; custom sep: {{video.songs|, }}),
#                   perf_date, event, camera_type, channel_title, playlist_title,
#                   tags (array), duration_seconds, status
#
# Move the downloaded files into a library folder:
# SHELL_COMMAND_VIDEO=mv {{each video}}"{{video.youtube_id}}".* {{/each}}/path/to/library/
#
# RENAME_TEMPLATE_VIDEO — new-name template for the "Переименовать" action. The server MOVES each
# video's linked file(s) into FILES_OUTPUT_DIR (required for this action) and renames them with this
# template. Defines ONLY the destination name (without extension; the source extension is preserved).
# Same {{video.param}} tokens. E.g. /input/abc.mp4 → /output/220804 Hype Boy (NewJeans MINJI FanCam) @MCOUNTDOWN.mp4
# RENAME_TEMPLATE_VIDEO={{video.perf_date}} {{video.song_title}} ({{video.group_name}} {{video.artist_name}} {{video.camera_type}}) {{video.event}}

# Dangerous actions (allows destructive API endpoints; disabled by default)
MEDIA_LIBRARY_DANGEROUS_ACTIONS_ENABLED=false

# K-pop dictionary auto-refresh (@vidpulse/kpop-sources → Wikidata).
# Populates groups/artists/aliases in the dictionary on a schedule. Opt-in: disabled by default.
# Requires outbound network access to query.wikidata.org (allowlist it in your environment's
# egress settings). Wikidata requires a descriptive User-Agent.
KPOP_DICT_REFRESH_ENABLED=false
# Cron schedule (default: weekly, Monday 04:00). Standard 5-field cron.
KPOP_DICT_CRON_TIME=0 4 * * 1
# Descriptive User-Agent sent to Wikidata (include contact/repo URL).
KPOP_SOURCES_USER_AGENT=VidPulse-KpopDB/1.0 (+https://github.com/ilikosov/vidpulse)
# Optional cap on the number of groups fetched per refresh (omit for no cap).
# KPOP_DICT_LIMIT=500

# MusicBrainz song enrichment (full track-lists: album tracks + B-sides that Wikidata lacks).
# Opt-in and SEPARATE from the Wikidata refresh because it is slow (≤1 req/s → minutes for the
# full set). When enabled, the K-pop refresh also fetches each group's recordings from MusicBrainz
# (bridged via the group's Wikidata MusicBrainz id, P434) and merges them into the group's songs.
# Requires outbound access to musicbrainz.org (allowlist it) and a descriptive User-Agent.
MUSICBRAINZ_REFRESH_ENABLED=false
# Descriptive User-Agent sent to MusicBrainz (include contact/repo URL) — required by their ToS.
MUSICBRAINZ_USER_AGENT=VidPulse-KpopDB/1.0 (+https://github.com/ilikosov/vidpulse)
# Minimum ms between MusicBrainz requests (≤1 req/s per their policy).
MUSICBRAINZ_RATE_LIMIT_MS=1000
# Optional cap on the number of groups enriched per refresh (omit for no cap).
# MUSICBRAINZ_LIMIT=100

# LM Studio (local OpenAI-compatible endpoint)
LM_STUDIO_API_URL=http://localhost:1234/v1/chat/completions
# LM_STUDIO_URL is a legacy alias for LM_STUDIO_API_URL
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT=30000
