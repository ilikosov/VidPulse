# Server
PORT=3000

# Database (SQLite file paths — REQUIRED)
DATABASE_PATH=apps/server/src/db/dev.sqlite3
TEST_DATABASE_PATH=apps/server/src/db/dev.test.sqlite3

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
LOG_YOUTUBE_API_CALLS=false
# YOUTUBE_API_PROXY=http://proxy-host:8080
# YOUTUBE_API_PROXY_USER=username
# YOUTUBE_API_PROXY_PASS=password
# YOUTUBE_API_CONNECTIVITY_TIMEOUT=5000
# YOUTUBE_API_REQUEST_TIMEOUT=10000   # ms; abort a YouTube API request after this timeout

# Sync scheduler
SYNC_CRON_TIME=0 3 * * *

# Videos
HIDE_FLAGGED_VIDEOS=false
MAX_VIDEO_LIST_ITEMS=100

# Files (physical files on disk; linked to videos by youtube_id filename prefix)
# FILES_INPUT_DIR=/path/to/incoming   # directory scanned for new files
# FILES_OUTPUT_DIR=/path/to/library   # directory files are moved to after renaming
# FILES_FILTER=mp4,mkv,avi,mov        # comma-separated extensions to include (all files if unset)
# Template for the "Команда для видео" action. Uses {{video.param}} tokens and an optional
# {{each video}}…{{/each}} loop so a multi-video selection becomes one command.
# (Do not use '#' in the template — dotenv treats '#' as a comment character.)
#
# Available params: youtube_id, youtube_url, title, group_name, artist_name,
#                   song_title, songs, perf_date, event, camera_type,
#                   channel_title, playlist_title, tags, duration_seconds, status
#
# Rename files to "<date> <group> <artist> - <song> <event>.mp4":
# SHELL_COMMAND_VIDEO={{each video}}mv "{{video.youtube_id}}.mp4" "{{video.perf_date}} {{video.group_name}} {{video.artist_name}} - {{video.song_title}} {{video.event}}.mp4"; {{/each}}

# Dangerous actions (allows destructive API endpoints; disabled by default)
MEDIA_LIBRARY_DANGEROUS_ACTIONS_ENABLED=false

# LM Studio (local OpenAI-compatible endpoint)
LM_STUDIO_API_URL=http://localhost:1234/v1/chat/completions
# LM_STUDIO_URL is a legacy alias for LM_STUDIO_API_URL
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT=30000
