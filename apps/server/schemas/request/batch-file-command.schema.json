{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidpulse.local/schemas/request/batch-file-command.schema.json",
  "title": "Batch File Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["videoIds"],
  "properties": {
    "videoIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "excludeExistingFiles": { "type": "boolean" }
  }
}
