{
  "name": "@vidpulse/db",
  "version": "1.0.0",
  "description": "Database connection, knex config, migrations, seeds, and repositories for VidPulse",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "migrate": "NODE_OPTIONS=\"--import tsx\" knex migrate:latest --knexfile src/knexfile.ts",
    "seed": "NODE_OPTIONS=\"--import tsx\" knex seed:run --knexfile src/knexfile.ts"
  },
  "dependencies": {
    "@vidpulse/config": "*",
    "better-sqlite3": "^12.9.0",
    "knex": "^3.2.9"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
