{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidpulse.local/schemas/request/video-list.schema.json",
  "title": "Video List",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "videoIds": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
