{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n BE,FE -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "test": "npm run test -w apps/server",
    "test:e2e": "npm run test:e2e -w apps/server",
    "dev:all": "npm install && npx knex migrate:latest --knexfile apps/server/src/db/knexfile.ts && npm run dev",
    "prepare": "husky",
    "format": "prettier --write \"apps/server/src/**/*.{ts,tsx,js,json,css,md}\" \"apps/web/src/**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"apps/server/src/**/*.{ts,tsx,js,json,css,md}\" \"apps/web/src/**/*.{ts,tsx,js,json,css,md}\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
