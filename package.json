{
  "name": "vidpulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @vidpulse/db && dotenv -e .env -- npm run dev -w apps/server",
    "build": "npm run build -w @vidpulse/db && npm run build -w apps/server && npm run build -w apps/web",
    "start": "dotenv -e .env -- npm run start -w apps/server",
    "test": "dotenv -e .env.test -- npm run test -w apps/server",
    "test:e2e": "npm run test:e2e -w apps/server",
    "migrate": "dotenv -e .env -- npm run migrate -w @vidpulse/db",
    "seed": "dotenv -e .env -- npm run seed -w @vidpulse/db",
    "launch": "dotenv -e .env -- concurrently -n BE,FE -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:all": "npm install && npm run build -w @vidpulse/db && dotenv -e .env -- npm run migrate -w @vidpulse/db && npm run launch",
    "prepare": "husky",
    "format": "prettier --write \"apps/server/src/**/*.{ts,tsx,js,json,css,md}\" \"apps/web/src/**/*.{ts,tsx,js,json,css,md}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"apps/server/src/**/*.{ts,tsx,js,json,css,md}\" \"apps/web/src/**/*.{ts,tsx,js,json,css,md}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"docs/**/*.md\" \"*.md\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
